!==============================================================================
! プログラム名: numerical_differentiation
!
! 【目的】
!   関数 f(x) = sin(x) の微分を、差分（離散的な近似）で求める。
!   数学では d/dx sin(x) = cos(x) だが、コンピュータでは「極限」は使えない。
!   代わりに、近くの点の値を使って傾きを近似する（これが「差分」）。
!
! 【3つの差分公式】
!   前進差分 : { f(x + Δx) - f(x)       } / Δx
!   後退差分 : { f(x)       - f(x - Δx) } / Δx
!   中央差分 : { f(x + Δx) - f(x - Δx) } / (2Δx)
!
! 【出力】
!   output.csv … Python でグラフ描画するためのデータファイル
!==============================================================================
program numerical_differentiation
    implicit none

    !--------------------------------------------------------------------------
    ! 変数の宣言
    !--------------------------------------------------------------------------
    integer, parameter :: n  = 10     ! サンプリング点数（点が多いほど精度が上がる）
    real(8), parameter :: pi = 3.141592653589793d0  ! 円周率 π

    real(8) :: x(n)        ! 各点の x 座標
    real(8) :: f(n)        ! 各点での f(x) = sin(x)
    real(8) :: h           ! 点と点の間隔 Δx（離散間隔）
    real(8) :: forward(n)  ! 前進差分で求めた微分の近似値
    real(8) :: backward(n) ! 後退差分で求めた微分の近似値
    real(8) :: central(n)  ! 中央差分で求めた微分の近似値
    real(8) :: exact(n)    ! 真の微分値 cos(x)（比較用）

    integer :: i           ! do ループのカウンタ
    character(len=20) :: filename = "output.csv"

    !--------------------------------------------------------------------------
    ! CSV ファイルを開く（status="replace" で上書き作成）
    !--------------------------------------------------------------------------
    open(unit=10, file=filename, status="replace")
    write(10, '(A)') "x,sin(x),cos(x),Forward Diff,Backward Diff,Central Diff"

    !--------------------------------------------------------------------------
    ! ステップ1: x の値と sin(x), cos(x) を計算する
    !
    ! 区間 [0, π] を n 点に等間隔で分割する。
    ! 例: n=10 のとき、Δx = π / 9 ≈ 0.349
    !     x = 0, 0.349, 0.698, ..., π
    !--------------------------------------------------------------------------
    h = pi / (n - 1)

    do i = 1, n
        x(i)     = (i - 1) * h   ! i=1 → x=0, i=2 → x=Δx, ...
        f(i)     = sin(x(i))     ! 関数値
        exact(i) = cos(x(i))     ! 真の微分値（答え合わせ用）
    end do

    !--------------------------------------------------------------------------
    ! ステップ2: 3種類の差分で微分を近似する
    !
    ! 注意: 端点では片側の点しか使えないため、計算できない差分は 0 とする。
    !   - 前進差分 … 最後の点 (i=n) では右側の点がない
    !   - 後退差分 … 最初の点 (i=1) では左側の点がない
    !   - 中央差分 … 最初と最後の点では左右両方使えない
    !--------------------------------------------------------------------------
    do i = 1, n

        ! --- 前進差分 ---
        ! 現在の点 x(i) と、右隣の点 x(i+1) を使う
        if (i < n) then
            forward(i) = (f(i+1) - f(i)) / h
        else
            forward(i) = 0.0d0
        end if

        ! --- 後退差分 ---
        ! 左隣の点 x(i-1) と、現在の点 x(i) を使う
        if (i > 1) then
            backward(i) = (f(i) - f(i-1)) / h
        else
            backward(i) = 0.0d0
        end if

        ! --- 中央差分 ---
        ! 左隣 x(i-1) と右隣 x(i+1) の両方を使う（最も精度が高い）
        if (i > 1 .and. i < n) then
            central(i) = (f(i+1) - f(i-1)) / (2.0d0 * h)
        else
            central(i) = 0.0d0
        end if

        ! CSV に1行ずつ書き込む
        write(10, '(F15.8, ", ", F15.8, ", ", F15.8, ", ", F15.8, ", ", F15.8, ", ", F15.8)') &
            x(i), f(i), exact(i), forward(i), backward(i), central(i)
    end do

    close(10)
    print *, "計算結果を output.csv に保存しました。"

end program numerical_differentiation
