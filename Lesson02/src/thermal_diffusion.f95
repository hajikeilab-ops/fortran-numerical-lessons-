!==============================================================================
! プログラム名: thermal_diffusion
!
! 【目的】
!   1 次元熱伝導方程式を、显式差分法（フォワード・オイラー）で数値的に解く。
!   計算結果は CSV に出力し、Python (main.py) でグラフ化する。
!
! 【解く方程式】
!   ∂T/∂t = κ ∂²T/∂x²
!
!   T   … 温度
!   κ   … 熱拡散係数（このプログラムでは kp = 1.0）
!   t   … 時間
!   x   … 空間座標（0 から length まで）
!
! 【離散化（显式差分）】
!   空間 2 階微分を中心差分で近似:
!     ∂²T/∂x² ≈ { T(i-1) - 2*T(i) + T(i+1) } / Δx²
!
!   時間微分を前進差分で近似:
!     ∂T/∂t ≈ { T_new(i) - T_old(i) } / Δt
!
!   まとめると、内部点 i (2 ≤ i ≤ iend-1) について:
!     T_new(i) = T_old(i) + κ*Δt/Δx² * { T_old(i-1) - 2*T_old(i) + T_old(i+1) }
!
!   ここで kdt = κ*Δt/Δx² とおくと、更新式は:
!     T_ftr(i) = T_pst(i) + kdt * ( T_pst(i-1) - 2*T_pst(i) + T_pst(i+1) )
!
! 【境界条件】
!   両端 i=1, i=iend はディリクレ条件（温度を固定）。
!   このプログラムでは、端点の値は初期条件のまま更新しない。
!   → ループは i = 2 から iend-1 のみを更新する。
!
! 【初期条件】
!   三角形分布: x=0 から頂点 (x=length/2) まで線形増加、
!               頂点から x=length まで線形減少。
!
! 【出力ファイル】
!   grid.csv   … 空間座標 x（Python が横軸に使う）
!   output.csv … 各時刻の温度 T_1, T_2, ...（Python がヒートマップ等に使う）
!
! 【安定性の注意】
!   显式法では κ*Δt/Δx² ≤ 1/2 程度が安定条件の目安。
!   現在の設定: dx = length/(iend-1), kdt = κ*Δt/dx² を要確認。
!==============================================================================
program thermal_diffusion
    implicit none

    !--------------------------------------------------------------------------
    ! パラメータ（ここを変えると計算条件が変わる）
    !--------------------------------------------------------------------------
    integer, parameter :: iend = 100     ! 空間方向の格子点数
    integer, parameter :: nend = 2500    ! 時間ステップ数
    integer, parameter :: output_stride = 10  ! CSV 出力間隔（描画用。計算は毎ステップ）
    real(8), parameter :: kp     = 1.0d0   ! 熱拡散係数 κ
    real(8), parameter :: length = 10.0d0  ! 空間領域の長さ [0, length]
    real(8), parameter :: dt     = 0.004d0 ! 時間刻み Δt [s]

    !--------------------------------------------------------------------------
    ! 変数の宣言
    !--------------------------------------------------------------------------
    real(8) :: dx, kdt                   ! Δx（空間刻み）, κ*Δt/Δx²
    real(8), allocatable :: x(:)         ! 各格子点の x 座標
    real(8), allocatable :: T_pst(:)     ! 現在（過去）ステップの温度
    real(8), allocatable :: T_ftr(:)     ! 次ステップの温度（更新用バッファ）

    integer :: i, n                      ! 空間インデックス, 時間ステップカウンタ
    character(len=20) :: grid_file = "grid.csv"
    character(len=20) :: output_file = "output.csv"

    !--------------------------------------------------------------------------
    ! 格子間隔と更新係数を計算
    !
    ! dx  = length / (iend - 1)
    !   例: iend=100, length=10 → dx ≈ 0.101
    !
    ! kdt = κ * Δt / Δx²
    !   これが显式更新式の係数になる。
    !--------------------------------------------------------------------------
    dx  = length / dble(iend - 1)
    kdt = kp * dt / (dx * dx)

    allocate(x(iend), T_pst(iend), T_ftr(iend))

    !--------------------------------------------------------------------------
    ! ステップ1: 空間グリッドの生成
    !
    ! x(1) = 0, x(2) = dx, ..., x(iend) = length
    !--------------------------------------------------------------------------
    do i = 1, iend
        x(i) = dx * dble(i - 1)
    end do

    !--------------------------------------------------------------------------
    ! ステップ2: 初期条件（三角形分布）の設定
    !
    !   x=0 ──↗ 頂点(x=length/2) ──↘ x=length
    !        線形増加          線形減少
    !
    ! 左半分: T = x
    ! 右半分: T = length - x
    !--------------------------------------------------------------------------
    do i = 1, iend
        if (i <= iend / 2) then
            T_pst(i) = x(i)
        else
            T_pst(i) = length - x(i)
        end if
    end do

    !--------------------------------------------------------------------------
    ! ステップ3: 空間座標 grid.csv を出力
    !
    ! Python の main.py が横軸データとして読み込む。
    ! 形式:
    !   x
    !   0.00000000
    !   0.10101010
    !   ...
    !--------------------------------------------------------------------------
    open(unit=11, file=grid_file, status="replace")
    write(11, '(A)') "x"
    do i = 1, iend
        write(11, '(F15.8)') x(i)
    end do
    close(11)

    !--------------------------------------------------------------------------
    ! ステップ4: output.csv のヘッダ行を書き込む
    !
    ! 1 行目の例:
    !   time,T_1,T_2,T_3,...,T_100
    !
    ! 2 行目以降は各時刻の温度分布:
    !   0.00400000,T(1),T(2),...,T(iend)
    !--------------------------------------------------------------------------
    open(unit=10, file=output_file, status="replace")
    write(10, '(A)', advance="no") "time"
    do i = 1, iend
        write(10, '(A,I0)', advance="no") ",T_", i
    end do
    write(10, *)

    !--------------------------------------------------------------------------
    ! ステップ5: 時間発展の計算（显式差分法）
    !
    ! n = 1 から nend まで繰り返す。
    ! 各ステップで:
    !   (1) 内部点の温度を更新式で計算 → T_ftr
    !   (2) T_ftr を T_pst にコピー（次ステップの「過去」になる）
    !   (3) output_stride ごとに CSV へ 1 行書き出す（描画高速化のため間引き）
    !
    ! 端点 i=1, i=iend はループに入れない → 初期値のまま固定（ディリクレ）
    !--------------------------------------------------------------------------
    do n = 1, nend

        ! --- 内部点の更新 ---
        ! 3 点ステンシル: (i-1), i, (i+1) の温度を使う
        do i = 2, iend - 1
            T_ftr(i) = T_pst(i) + kdt * (T_pst(i - 1) - 2.0d0 * T_pst(i) + T_pst(i + 1))
        end do

        ! 未来の値を過去に反映（次の時間ステップの入力になる）
        T_pst(2:iend - 1) = T_ftr(2:iend - 1)

        ! --- CSV 出力（間引き: 最終ステップは必ず書く）---
        if (mod(n - 1, output_stride) == 0 .or. n == nend) then
            write(10, '(F12.6)', advance="no") dble(n) * dt
            do i = 1, iend
                write(10, '(A,F12.6)', advance="no") ",", T_pst(i)
            end do
            write(10, *)
        end if
    end do

    close(10)

    ! 動的配列の解放
    deallocate(x, T_pst, T_ftr)

    print *, "計算結果を grid.csv と output.csv に保存しました。"

end program thermal_diffusion
